# ==============================================================================
# HarmonicRAG Environment Configuration
# ==============================================================================

# Gemini API credentials (legacy GOOGLE_API_KEY remains supported)
GEMINI_API_KEY=your_gemini_api_key_here

# Generative & Embedding Models
# Primary generative model: gemini-2.5-flash (or gemini-1.5-flash / gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# Primary embedding model: gemini-embedding-001
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_REQUEST_TIMEOUT_MS=30000

# The supported deployment serves frontend and API together from FastAPI.
# A separately hosted frontend needs its own build-time API URL configuration.
API_BASE_URL=
CORS_ALLOWED_ORIGINS=

# Storage Paths (relative to backend/app or absolute)
CHROMA_PERSIST_DIRECTORY=../data/chroma
DOCUMENT_STORAGE_DIRECTORY=../data/documents
METADATA_STORAGE_DIRECTORY=../data/metadata

# Upload Limits
MAX_UPLOAD_SIZE_MB=25

# RAG Retrieval Configuration
TOP_K_DENSE=10
TOP_K_LEXICAL=10
TOP_K_FINAL=5
RRF_K=60
RELEVANCE_THRESHOLD=0.005

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=False
